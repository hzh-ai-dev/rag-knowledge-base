# ==========================================================
#  配置：复制本文件为 .env 后填入你的 API Key
#    Windows:      copy .env.example .env
#    macOS/Linux:  cp .env.example .env
# ==========================================================

# ==========================================================
#  推荐 · 全免费：智谱 GLM
#    1) 打开 https://open.bigmodel.cn 注册并完成实名认证
#    2) 控制台 -> API Keys，复制你的 key
#    3) 粘贴到下面即可（glm-4-flash 与 embedding-3 均免费）
# ==========================================================
OPENAI_API_KEY=在这里粘贴你的key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-flash

# ---- 向量模型 ----
# openai = 调用远程 embeddings 接口；local = 使用 sentence-transformers 本地模型
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=embedding-3
# EMBEDDING_PROVIDER=local 时生效（需额外安装，见 README）
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ==========================================================
#  其它厂商（三选一，取消注释即可切换）
# ==========================================================
# 硅基流动 SiliconFlow（embedding 免费）：https://cloud.siliconflow.cn
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# EMBEDDING_MODEL=BAAI/bge-m3
#
# 通义千问（阿里云百炼）：https://bailian.console.aliyun.com
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# EMBEDDING_MODEL=text-embedding-v3
#
# DeepSeek（对话便宜，但没有 embedding 接口）—— 需改用本地向量模型或另一家的 embedding
# OPENAI_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# EMBEDDING_PROVIDER=local
# LLM_MODEL 之外，OpenAI 官方亦可：https://api.openai.com/v1 + gpt-4o-mini

# ==========================================================
#  分块与检索参数（一般不用改）
# ==========================================================
CHUNK_SIZE=700
CHUNK_OVERLAP=120

TOP_K=6
VECTOR_TOP_K=20
BM25_TOP_K=20
ENABLE_HYBRID=true
ENABLE_RERANK=false
RRF_K=60

# ==========================================================
#  运行参数
# ==========================================================
DEBUG=false
HOST=0.0.0.0
PORT=8000
LLM_TEMPERATURE=0.1
MAX_HISTORY_TURNS=6
